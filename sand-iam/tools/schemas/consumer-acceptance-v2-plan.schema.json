{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "candidate", "origins", "database", "scope_cleanup", "fixture_manifest_sha256", "actions", "secret_slots"],
  "properties": {
    "schema": {"const": "sand-iam.consumer-acceptance-v2-plan/v1"},
    "run_id": {"$ref": "#/$defs/id"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "origins": {"$ref": "#/$defs/origins"},
    "database": {"$ref": "#/$defs/database"},
    "scope_cleanup": {"$ref": "#/$defs/scope_cleanup"},
    "fixture_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "actions": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "prefixItems": [
        {"const": "iam_login"}, {"const": "a_decide"}, {"const": "a_session_revoke"},
        {"const": "a_consumer_read"}, {"const": "a_consumer_close"}, {"const": "b_issue"},
        {"const": "b_verify"}, {"const": "b_provider_process"}, {"const": "admin_credential_revoke"},
        {"const": "admin_grant_revoke"}, {"const": "admin_audit"}
      ],
      "items": false
    },
    "secret_slots": {"$ref": "#/$defs/secret_slots"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,95}$"},
    "origin": {"type": "string", "pattern": "^https://[a-z0-9.-]+$"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_sha256", "host_sha256", "clean_host_revision_sha256", "tree_a_sha256", "tree_b_sha256"],
      "properties": {
        "candidate_sha256": {"$ref": "#/$defs/sha256"}, "host_sha256": {"$ref": "#/$defs/sha256"},
        "clean_host_revision_sha256": {"$ref": "#/$defs/sha256"}, "tree_a_sha256": {"$ref": "#/$defs/sha256"},
        "tree_b_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "origins": {
      "type": "object", "additionalProperties": false, "required": ["iam", "a", "b"],
      "properties": {"iam": {"$ref": "#/$defs/origin"}, "a": {"$ref": "#/$defs/origin"}, "b": {"$ref": "#/$defs/origin"}}
    },
    "database_binding": {
      "type": "object", "additionalProperties": false, "required": ["role", "schema_fingerprint_sha256"],
      "properties": {"role": {"$ref": "#/$defs/id"}, "schema_fingerprint_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "database": {
      "type": "object", "additionalProperties": false, "required": ["iam", "a", "b"],
      "properties": {"iam": {"$ref": "#/$defs/database_binding"}, "a": {"$ref": "#/$defs/database_binding"}, "b": {"$ref": "#/$defs/database_binding"}}
    },
    "scope_cleanup": {
      "type": "object", "additionalProperties": false, "required": ["scope_sha256", "cleanup_sha256"],
      "properties": {"scope_sha256": {"$ref": "#/$defs/sha256"}, "cleanup_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "secret_slots": {
      "type": "object", "additionalProperties": false, "required": ["iam_admin", "a_user", "b_workload"],
      "properties": {
        "iam_admin": {"const": "SAND_IAM_ADMIN_TOKEN"}, "a_user": {"const": "CONSUMER_A_USER_TOKEN"},
        "b_workload": {"const": "PROVIDER_B_WORKLOAD_CREDENTIAL"}
      }
    }
  }
}
