{
  "name": "example/sand-iam-standalone-business-consumer",
  "description": "Controlled non-AI SandIAM business consumer example",
  "type": "project",
  "repositories": [
    {
      "type": "path",
      "url": "../../../sdk/php",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "sand/iam-sdk": "*"
  },
  "autoload": {
    "psr-4": {
      "Example\\Standalone\\": "src/"
    }
  },
  "scripts": {
    "test:offline": "php tests/offline_test.php"
  }
}
