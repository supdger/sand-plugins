-- ----------------------------
-- Table structure for sand_system_login_log
-- ----------------------------
DROP TABLE IF EXISTS "sand_system_login_log" CASCADE;
CREATE TABLE "sand_system_login_log" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "username" varchar(20) NULL DEFAULT NULL,
  "ip" varchar(45) NULL DEFAULT NULL,
  "ip_location" varchar(255) NULL DEFAULT NULL,
  "os" varchar(50) NULL DEFAULT NULL,
  "browser" varchar(50) NULL DEFAULT NULL,
  "status" smallint NULL DEFAULT 1,
  "message" varchar(50) NULL DEFAULT NULL,
  "login_time" timestamp(0) without time zone NOT NULL DEFAULT CURRENT_TIMESTAMP(0),
  "remark" varchar(255) NULL DEFAULT NULL,
  "created_by" integer NULL DEFAULT NULL,
  "updated_by" integer NULL DEFAULT NULL,
  "create_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "update_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "delete_time" timestamp(0) without time zone NULL DEFAULT NULL,
  PRIMARY KEY ("id")
);
CREATE INDEX "idx_sand_system_login_log_username" ON "sand_system_login_log" ("username");
CREATE INDEX "idx_sand_system_login_log_idx_create_time" ON "sand_system_login_log" ("create_time");
CREATE INDEX "idx_sand_system_login_log_idx_login_time" ON "sand_system_login_log" ("login_time");

-- ----------------------------
-- Records of sand_system_login_log
-- ----------------------------

-- ----------------------------
-- Table structure for sand_system_mail
-- ----------------------------
DROP TABLE IF EXISTS "sand_system_mail" CASCADE;
CREATE TABLE "sand_system_mail" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "gateway" varchar(50) NULL DEFAULT NULL,
  "from" varchar(50) NULL DEFAULT NULL,
  "email" varchar(50) NULL DEFAULT NULL,
  "code" varchar(20) NULL DEFAULT NULL,
  "content" varchar(500) NULL DEFAULT NULL,
  "status" varchar(20) NULL DEFAULT NULL,
  "response" varchar(500) NULL DEFAULT NULL,
  "create_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "update_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "delete_time" timestamp(0) without time zone NULL DEFAULT NULL,
  PRIMARY KEY ("id")
);
CREATE INDEX "idx_sand_system_mail_idx_create_time" ON "sand_system_mail" ("create_time");

-- ----------------------------
-- Records of sand_system_mail
-- ----------------------------

-- ----------------------------
-- Table structure for sand_system_menu
-- ----------------------------
DROP TABLE IF EXISTS "sand_system_menu" CASCADE;
CREATE TABLE "sand_system_menu" (
  "id" bigint NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "parent_id" bigint NULL DEFAULT 0,
  "name" varchar(64) NOT NULL,
  "code" varchar(64) NULL DEFAULT NULL,
  "slug" varchar(100) NULL DEFAULT NULL,
  "type" smallint NOT NULL DEFAULT 1,
  "path" varchar(255) NULL DEFAULT NULL,
  "component" varchar(255) NULL DEFAULT NULL,
  "method" varchar(10) NULL DEFAULT NULL,
  "icon" varchar(64) NULL DEFAULT NULL,
  "sort" integer NULL DEFAULT 100,
  "link_url" varchar(255) NULL DEFAULT NULL,
  "is_iframe" smallint NULL DEFAULT 2,
  "is_keep_alive" smallint NULL DEFAULT 2,
  "is_hidden" smallint NULL DEFAULT 2,
  "is_fixed_tab" smallint NULL DEFAULT 2,
  "is_full_page" smallint NULL DEFAULT 2,
  "generate_id" integer NULL DEFAULT 0,
  "generate_key" varchar(255) NULL DEFAULT NULL,
  "status" smallint NULL DEFAULT 1,
  "remark" varchar(255) NULL DEFAULT NULL,
  "created_by" integer NULL DEFAULT NULL,
  "updated_by" integer NULL DEFAULT NULL,
  "create_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "update_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "delete_time" timestamp(0) without time zone NULL DEFAULT NULL,
  PRIMARY KEY ("id")
);
CREATE INDEX "idx_sand_system_menu_idx_parent_id" ON "sand_system_menu" ("parent_id");
CREATE INDEX "idx_sand_system_menu_idx_slug" ON "sand_system_menu" ("slug");

