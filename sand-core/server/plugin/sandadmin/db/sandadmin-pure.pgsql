-- ----------------------------
-- Table structure for sand_system_oper_log
-- ----------------------------
DROP TABLE IF EXISTS "sand_system_oper_log" CASCADE;
CREATE TABLE "sand_system_oper_log" (
  "id" bigint NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "username" varchar(20) NULL DEFAULT NULL,
  "app" varchar(50) NULL DEFAULT NULL,
  "method" varchar(20) NULL DEFAULT NULL,
  "router" varchar(500) NULL DEFAULT NULL,
  "service_name" varchar(30) NULL DEFAULT NULL,
  "ip" varchar(45) NULL DEFAULT NULL,
  "ip_location" varchar(255) NULL DEFAULT NULL,
  "request_data" text NULL,
  "remark" varchar(255) NULL DEFAULT NULL,
  "created_by" integer NULL DEFAULT NULL,
  "updated_by" integer NULL DEFAULT NULL,
  "create_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "update_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "delete_time" timestamp(0) without time zone NULL DEFAULT NULL,
  PRIMARY KEY ("id")
);
CREATE INDEX "idx_sand_system_oper_log_username" ON "sand_system_oper_log" ("username");
CREATE INDEX "idx_sand_system_oper_log_idx_create_time" ON "sand_system_oper_log" ("create_time");

-- ----------------------------
-- Records of sand_system_oper_log
-- ----------------------------

-- ----------------------------
-- Table structure for sand_system_post
-- ----------------------------
DROP TABLE IF EXISTS "sand_system_post" CASCADE;
CREATE TABLE "sand_system_post" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "name" varchar(50) NULL DEFAULT NULL,
  "code" varchar(100) NULL DEFAULT NULL,
  "sort" smallint NULL DEFAULT 0,
  "status" smallint NULL DEFAULT 1,
  "remark" varchar(255) NULL DEFAULT NULL,
  "created_by" integer NULL DEFAULT NULL,
  "updated_by" integer NULL DEFAULT NULL,
  "create_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "update_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "delete_time" timestamp(0) without time zone NULL DEFAULT NULL,
  PRIMARY KEY ("id")
);


-- ----------------------------
-- Table structure for sand_system_role
-- ----------------------------
DROP TABLE IF EXISTS "sand_system_role" CASCADE;
CREATE TABLE "sand_system_role" (
  "id" bigint NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "name" varchar(64) NOT NULL,
  "code" varchar(64) NOT NULL,
  "level" integer NULL DEFAULT 1,
  "data_scope" smallint NULL DEFAULT 1,
  "remark" varchar(255) NULL DEFAULT NULL,
  "sort" integer NULL DEFAULT 100,
  "status" smallint NULL DEFAULT 1,
  "created_by" integer NULL DEFAULT NULL,
  "updated_by" integer NULL DEFAULT NULL,
  "create_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "update_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "delete_time" timestamp(0) without time zone NULL DEFAULT NULL,
  PRIMARY KEY ("id")
);
CREATE UNIQUE INDEX "idx_sand_system_role_uk_slug" ON "sand_system_role" ("code");

-- ----------------------------
-- Records of sand_system_role
-- ----------------------------
INSERT INTO "sand_system_role" VALUES (1, '超级管理员', 'super_admin', 100, 1, '系统维护者，拥有所有权限', 100, 1, 1, 1, '2026-01-01 00:00:00', '2026-01-01 00:00:00', NULL);

