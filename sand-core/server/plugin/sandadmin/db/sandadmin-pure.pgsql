-- ----------------------------
-- Table structure for sand_system_config
-- ----------------------------
DROP TABLE IF EXISTS "sand_system_config" CASCADE;
CREATE TABLE "sand_system_config" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "group_id" integer NULL DEFAULT NULL,
  "key" varchar(32) NOT NULL,
  "value" text NULL,
  "name" varchar(255) NULL DEFAULT NULL,
  "input_type" varchar(32) NULL DEFAULT NULL,
  "config_select_data" varchar(500) NULL DEFAULT NULL,
  "sort" smallint NULL DEFAULT 0,
  "remark" varchar(255) NULL DEFAULT NULL,
  "created_by" integer NULL DEFAULT NULL,
  "updated_by" integer NULL DEFAULT NULL,
  "create_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "update_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "delete_time" timestamp(0) without time zone NULL DEFAULT NULL,
  PRIMARY KEY ("id", "key")
);
