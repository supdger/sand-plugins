-- ----------------------------
-- Table structure for sand_system_dict_type
-- ----------------------------
DROP TABLE IF EXISTS "sand_system_dict_type" CASCADE;
CREATE TABLE "sand_system_dict_type" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "name" varchar(50) NULL DEFAULT NULL,
  "code" varchar(100) NULL DEFAULT NULL,
  "status" smallint NULL DEFAULT 1,
  "remark" varchar(255) NULL DEFAULT NULL,
  "created_by" integer NULL DEFAULT NULL,
  "updated_by" integer NULL DEFAULT NULL,
  "create_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "update_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "delete_time" timestamp(0) without time zone NULL DEFAULT NULL,
  PRIMARY KEY ("id")
);
CREATE INDEX "idx_sand_system_dict_type_idx_code" ON "sand_system_dict_type" ("code");
CREATE INDEX "idx_sand_system_dict_type_idx_name" ON "sand_system_dict_type" ("name");

