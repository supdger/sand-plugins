-- ----------------------------
-- Table structure for sand_tool_crontab
-- ----------------------------
DROP TABLE IF EXISTS "sand_tool_crontab" CASCADE;
CREATE TABLE "sand_tool_crontab" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "name" varchar(100) NULL DEFAULT NULL,
  "type" smallint NULL DEFAULT 4,
  "target" varchar(500) NULL DEFAULT NULL,
  "parameter" varchar(1000) NULL DEFAULT NULL,
  "task_style" smallint NULL DEFAULT NULL,
  "rule" varchar(32) NULL DEFAULT NULL,
  "singleton" smallint NULL DEFAULT 1,
  "status" smallint NULL DEFAULT 1,
  "remark" varchar(255) NULL DEFAULT NULL,
  "created_by" integer NULL DEFAULT NULL,
  "updated_by" integer NULL DEFAULT NULL,
  "create_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "update_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "delete_time" timestamp(0) without time zone NULL DEFAULT NULL,
  PRIMARY KEY ("id")
);


-- ----------------------------
-- Table structure for sand_tool_crontab_log
-- ----------------------------
DROP TABLE IF EXISTS "sand_tool_crontab_log" CASCADE;
CREATE TABLE "sand_tool_crontab_log" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "crontab_id" integer NULL DEFAULT NULL,
  "name" varchar(255) NULL DEFAULT NULL,
  "target" varchar(500) NULL DEFAULT NULL,
  "parameter" varchar(1000) NULL DEFAULT NULL,
  "exception_info" varchar(2000) NULL DEFAULT NULL,
  "status" smallint NULL DEFAULT 1,
  "create_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "update_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "delete_time" timestamp(0) without time zone NULL DEFAULT NULL,
  PRIMARY KEY ("id")
);


-- ----------------------------
-- Records of sand_tool_crontab_log
-- ----------------------------

-- ----------------------------
-- Table structure for sand_tool_generate_columns
-- ----------------------------
DROP TABLE IF EXISTS "sand_tool_generate_columns" CASCADE;
CREATE TABLE "sand_tool_generate_columns" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "table_id" integer NULL DEFAULT NULL,
  "column_name" varchar(200) NULL DEFAULT NULL,
  "column_comment" varchar(255) NULL DEFAULT NULL,
  "column_type" varchar(50) NULL DEFAULT NULL,
  "default_value" varchar(50) NULL DEFAULT NULL,
  "is_pk" smallint NULL DEFAULT 1,
  "is_required" smallint NULL DEFAULT 1,
  "is_insert" smallint NULL DEFAULT 1,
  "is_edit" smallint NULL DEFAULT 1,
  "is_list" smallint NULL DEFAULT 1,
  "is_query" smallint NULL DEFAULT 1,
  "is_sort" smallint NULL DEFAULT 1,
  "query_type" varchar(100) NULL DEFAULT 'eq',
  "view_type" varchar(100) NULL DEFAULT 'text',
  "dict_type" varchar(200) NULL DEFAULT NULL,
  "allow_roles" varchar(255) NULL DEFAULT NULL,
  "options" varchar(1000) NULL DEFAULT NULL,
  "sort" smallint NULL DEFAULT 0,
  "remark" varchar(255) NULL DEFAULT NULL,
  "created_by" integer NULL DEFAULT NULL,
  "updated_by" integer NULL DEFAULT NULL,
  "create_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "update_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "delete_time" timestamp(0) without time zone NULL DEFAULT NULL,
  PRIMARY KEY ("id")
);


-- ----------------------------
-- Records of sand_tool_generate_columns
-- ----------------------------

-- ----------------------------
-- Table structure for sand_tool_generate_tables
-- ----------------------------
DROP TABLE IF EXISTS "sand_tool_generate_tables" CASCADE;
CREATE TABLE "sand_tool_generate_tables" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "table_name" varchar(200) NULL DEFAULT NULL,
  "table_comment" varchar(500) NULL DEFAULT NULL,
  "stub" varchar(50) NULL DEFAULT NULL,
  "template" varchar(50) NULL DEFAULT NULL,
  "namespace" varchar(255) NULL DEFAULT NULL,
  "package_name" varchar(100) NULL DEFAULT NULL,
  "business_name" varchar(50) NULL DEFAULT NULL,
  "class_name" varchar(50) NULL DEFAULT NULL,
  "menu_name" varchar(100) NULL DEFAULT NULL,
  "belong_menu_id" integer NULL DEFAULT NULL,
  "tpl_category" varchar(100) NULL DEFAULT NULL,
  "generate_type" smallint NULL DEFAULT 1,
  "generate_path" varchar(100) NULL DEFAULT 'sandadmin-artd',
  "generate_model" smallint NULL DEFAULT 1,
  "generate_menus" varchar(255) NULL DEFAULT NULL,
  "build_menu" smallint NULL DEFAULT 1,
  "component_type" smallint NULL DEFAULT 1,
  "options" varchar(1500) NULL DEFAULT NULL,
  "form_width" integer NULL DEFAULT 800,
  "is_full" smallint NULL DEFAULT 1,
  "remark" varchar(255) NULL DEFAULT NULL,
  "source" varchar(255) NULL DEFAULT NULL,
  "created_by" integer NULL DEFAULT NULL,
  "updated_by" integer NULL DEFAULT NULL,
  "create_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "update_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "delete_time" timestamp(0) without time zone NULL DEFAULT NULL,
  PRIMARY KEY ("id")
);


-- ----------------------------
-- Records of sand_tool_generate_tables
-- ----------------------------

