-- ----------------------------
-- Table structure for sand_system_attachment
-- ----------------------------
DROP TABLE IF EXISTS "sand_system_attachment" CASCADE;
CREATE TABLE "sand_system_attachment" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "category_id" integer NULL DEFAULT 0,
  "storage_mode" smallint NULL DEFAULT 1,
  "origin_name" varchar(255) NULL DEFAULT NULL,
  "object_name" varchar(50) NULL DEFAULT NULL,
  "hash" varchar(64) NULL DEFAULT NULL,
  "mime_type" varchar(255) NULL DEFAULT NULL,
  "storage_path" varchar(100) NULL DEFAULT NULL,
  "suffix" varchar(10) NULL DEFAULT NULL,
  "size_byte" bigint NULL DEFAULT NULL,
  "size_info" varchar(50) NULL DEFAULT NULL,
  "url" varchar(255) NULL DEFAULT NULL,
  "remark" varchar(255) NULL DEFAULT NULL,
  "created_by" integer NULL DEFAULT NULL,
  "updated_by" integer NULL DEFAULT NULL,
  "create_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "update_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "delete_time" timestamp(0) without time zone NULL DEFAULT NULL,
  PRIMARY KEY ("id")
);
CREATE INDEX "idx_sand_system_attachment_hash" ON "sand_system_attachment" ("hash");
CREATE INDEX "idx_sand_system_attachment_idx_url" ON "sand_system_attachment" ("url");
CREATE INDEX "idx_sand_system_attachment_idx_create_time" ON "sand_system_attachment" ("create_time");
CREATE INDEX "idx_sand_system_attachment_idx_category_id" ON "sand_system_attachment" ("category_id");

-- ----------------------------
-- Records of sand_system_attachment
-- ----------------------------

-- ----------------------------
-- Table structure for sand_system_category
