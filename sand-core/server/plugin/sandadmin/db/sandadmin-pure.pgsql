  "role_id" bigint NOT NULL,
  "dept_id" bigint NOT NULL,
  PRIMARY KEY ("id")
);
CREATE INDEX "idx_sand_system_role_dept_idx_role_id" ON "sand_system_role_dept" ("role_id");
CREATE INDEX "idx_sand_system_role_dept_idx_dept_id" ON "sand_system_role_dept" ("dept_id");

