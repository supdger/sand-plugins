  "id" bigint NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "role_id" bigint NOT NULL,
  "menu_id" bigint NOT NULL,
  PRIMARY KEY ("id")
);
CREATE INDEX "idx_sand_system_role_menu_idx_menu_id" ON "sand_system_role_menu" ("menu_id");
CREATE INDEX "idx_sand_system_role_menu_idx_role_id" ON "sand_system_role_menu" ("role_id");

