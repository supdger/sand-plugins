SELECT setval(pg_get_serial_sequence('public.sand_tool_generate_tables', 'id'), COALESCE((SELECT MAX("id") FROM "sand_tool_generate_tables"), 1), EXISTS (SELECT 1 FROM "sand_tool_generate_tables"));
