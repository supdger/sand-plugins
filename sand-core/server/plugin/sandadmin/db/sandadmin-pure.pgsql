-- ----------------------------
-- Table structure for sand_system_user
-- ----------------------------
DROP TABLE IF EXISTS "sand_system_user" CASCADE;
CREATE TABLE "sand_system_user" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "username" varchar(64) NOT NULL,
  "password" varchar(255) NOT NULL,
  "realname" varchar(64) NULL DEFAULT NULL,
  "gender" varchar(10) NULL DEFAULT NULL,
  "avatar" varchar(255) NULL DEFAULT NULL,
  "email" varchar(128) NULL DEFAULT NULL,
  "phone" varchar(20) NULL DEFAULT NULL,
  "signed" varchar(255) NULL DEFAULT NULL,
  "dashboard" varchar(255) NULL DEFAULT 'work',
  "dept_id" bigint NULL DEFAULT NULL,
  "is_super" smallint NULL DEFAULT 0,
  "status" smallint NULL DEFAULT 1,
  "remark" varchar(255) NULL DEFAULT NULL,
  "login_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "login_ip" varchar(45) NULL DEFAULT NULL,
  "created_by" integer NULL DEFAULT NULL,
  "updated_by" integer NULL DEFAULT NULL,
  "create_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "update_time" timestamp(0) without time zone NULL DEFAULT NULL,
  "delete_time" timestamp(0) without time zone NULL DEFAULT NULL,
  PRIMARY KEY ("id")
);
CREATE UNIQUE INDEX "idx_sand_system_user_uk_username" ON "sand_system_user" ("username");
CREATE INDEX "idx_sand_system_user_idx_dept_id" ON "sand_system_user" ("dept_id");

