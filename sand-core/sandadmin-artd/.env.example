# 通用环境变量
# 以下变量缺失时 vite 启动会直接报错（不会代入 undefined）：
#   VITE_VERSION、VITE_PORT、VITE_BASE_URL、VITE_API_URL
#   另：开发服务（vite dev）还要求 VITE_API_PROXY_URL
# 发布时由 Sand Core 包版本注入（手工复制本文件时请自行填写）
VITE_VERSION = 3.0.2
VITE_PORT = 3006
VITE_BASE_URL = /
# 前端请求的 API 前缀（dev 下由 server.proxy 代理）
VITE_API_URL = /api
# 开发服务代理的后端地址（仅 vite dev 需要）
VITE_API_PROXY_URL = http://127.0.0.1:8787
VITE_ACCESS_MODE = backend
VITE_WITH_CREDENTIALS = false
VITE_OPEN_ROUTE_INFO = false
# 发布时自动生成随机值（手工复制本文件时请自行替换）
VITE_LOCK_ENCRYPT_KEY = change-me
